generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

//Tabela de Usuários 
model Usuario {
  id      String   @id @default(uuid())
  nome    String
  email   String   @unique
  //Usuário pode ter vários agendamentos
  eventos Evento[] 
}

//Tabela de Barbeiros
model Barbeiro {
  id            String   @id @default(uuid())
  nome          String
  especialidade String
  //barbeiro pode ter vários agendamentos
  eventos       Evento[] 
}

//Tabela de Eventos 
model Evento {
  id         String   @id @default(uuid())
  startTime  DateTime //Guarda a DATA e a HORA juntas
  endTime    DateTime // 
  
  //Relação com Usuário
  usuarioId  String
  usuario    Usuario  @relation(fields: [usuarioId], references: [id])
  
  //Relação com Barbeiro
  barbeiroId String
  barbeiro   Barbeiro @relation(fields: [barbeiroId], references: [id])
}